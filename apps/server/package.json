{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "main": "app.js",
  "scripts": {
    "start": "nodemon app.js",
    "dev": "nodemon app.js",
    "worker": "node src/workers/emailWorker.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:auth": "jest --forceExit --detectOpenHandles tests/auth.adversarial.test.js",
    "test:verbose": "jest --verbose --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "compression": "^1.8.0",
    "connect-timeout": "^1.9.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^7.5.1",
    "google-auth-library": "^10.9.1",
    "googleapis": "^160.0.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "html-escaper": "^3.0.3",
    "html-to-text": "^9.0.5",
    "jsonwebtoken": "^9.0.2",
    "method-override": "^3.0.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.5",
    "nodemailer": "^7.0.12",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.10.0",
    "sanitize-html": "^2.17.3",
    "sequelize": "^6.35.2",
    "sharp": "^0.35.5",
    "sitemap": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true,
    "testTimeout": 30000,
    "moduleNameMapper": {
      "^sanitize-html$": "<rootDir>/tests/__mocks__/sanitize-html.js"
    }
  }
}
