# ── Core
PORT=3300
NODE_ENV=production

# ── Database (MySQL)
DB_NAME=garik2026_mg_drive
DB_USERNAME=root
# Use a strong, unique password. Never commit a real one.
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=3306

# ── Auth / JWT
# JWT_SECRET must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_32_CHARS_MIN
JWT_EXPIRES_IN=60

# Dedicated CSRF secret (>= 32 chars). Generate like JWT_SECRET above.
CSRF_SECRET=CHANGE_ME_32_CHARS_MIN

# ── Redis
REDIS_URL=redis://127.0.0.1:6379
# REDIS_SOCKET=

# ── URLs / CORS (set to your real production domain, e.g. https://mgdrive.am)
SERVER_URL=https://example.com
CLIENT_URL=https://example.com
ADMIN_URL=https://example.com
FRONTEND_URL=https://example.com

# ── OAuth providers
# GOOGLE_CLIENT_ID is public (safe to share); the secret is NOT.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://example.com/auth

# ── Google Sheets
SPREADSHEET_ID=

# ── Email (SMTP)
EMAIL_FROM_NAME=MG-Drive
EMAIL_FROM_EMAIL=no-reply@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USERNAME=
EMAIL_PASSWORD=CHANGE_ME

# ── Secondary mailer
SENDPULSE_HOST=
SENDPULSE_PORT=2525
SENDPULSE_USERNAME=
SENDPULSE_PASSWORD=