# ──────────────────────────────────────────────────────────────
# docker-compose-ի համար պարտադիր փոփոխականներ (repo-ի արմատում)
# Պատճենիր՝  cp .env.example .env   և լրացրու ԻՐԱԿԱՆ արժեքներով։
# Այս ֆայլը commit է արվում (template է); իսկ `.env`-ը gitignored է։
# Ոչ մի ԻՐԱԿԱՆ գաղտնիք այստեղ չգրես, միայն `.env`-ում։
# ──────────────────────────────────────────────────────────────

# Դոմեն (https-ով) — նույնը գնում է SERVER_URL/CLIENT_URL/ADMIN_URL/FRONTEND_URL
SITE_URL=https://example.com

# Տվյալների բազա (MySQL)
DB_NAME=garik2026_mg_drive
DB_USERNAME=root
# Ուժեղ գաղտնաբառ, խորհուրդ՝ ալֆանումերիկ (առանց $ @ : / հատուկ նշանների)
DB_PASSWORD=CHANGE_ME

# Auth սեկրետներ — գեներացրու առանձին.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_32_CHARS_MIN
CSRF_SECRET=CHANGE_ME_32_CHARS_MIN

# Google OAuth (client id-ը public է, secret-ը՝ ոչ)
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
VITE_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# Պորտեր (ըստ ցանկության)
# DB_PORT=3306
# REDIS_PORT=6379
# SERVER_PORT=3300
# WEB_PORT=8080

# Email (SMTP) — լրացրու իրական արժեքներով
# EMAIL_FROM_NAME=MG-Drive
# EMAIL_FROM_EMAIL=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
